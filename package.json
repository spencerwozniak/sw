{
  "name": "spencerwozniak",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "postbuild": "next-sitemap",
    "start": "next start",
    "lint": "next lint",
    "test": "tsx --test \"tests/*.test.ts\" \"tests/unit/**/*.test.ts\"",
    "photos": "tsx scripts/process-photos.ts",
    "test:db": "DATABASE_URL=$(scripts/db.sh url test) tsx --test --test-concurrency=1 \"tests/db/*.test.ts\"",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:dev": "scripts/db.sh up dev",
    "db:test": "scripts/db.sh up test",
    "db:deploy": "prisma migrate deploy",
    "db:check": "tsx --env-file=.env.local scripts/check-db.ts",
    "blob:check": "tsx --env-file=.env.local scripts/check-blob.ts",
    "admin:hash": "tsx scripts/hash-password.ts",
    "verify:env": "tsx scripts/verify-env.ts",
    "verify:start": "scripts/verify-build.sh start",
    "verify:stop": "scripts/verify-build.sh stop",
    "verify:admin": "node --env-file=.env.verify scripts/browser/admin-auth.mjs && node --env-file=.env.verify scripts/browser/admin-kit.mjs"
  },
  "dependencies": {
    "@next/third-parties": "^15.3.2",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@stripe/react-stripe-js": "^3.7.0",
    "@stripe/stripe-js": "^7.5.0",
    "@vercel/blob": "^2.8.1",
    "aos": "^2.3.4",
    "axios": "^1.9.0",
    "dotenv": "^16.5.0",
    "framer-motion": "^12.18.1",
    "katex": "^0.16.22",
    "lucide-react": "^0.562.0",
    "next": "^15.5.12",
    "next-sitemap": "^4.2.3",
    "nodemailer": "^7.0.2",
    "openai": "^4.100.0",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.5.0",
    "react-katex": "^3.1.0",
    "react-markdown": "^10.1.0",
    "stripe": "^18.3.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/aos": "^3.0.7",
    "@types/node": "^20",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.21",
    "eslint": "^9",
    "eslint-config-next": "15.3.1",
    "exifr": "^7.1.3",
    "playwright-core": "^1.55.0",
    "postcss": "^8.5.6",
    "prisma": "^7.10.0",
    "sharp": "^0.34.3",
    "tailwindcss": "^4.1.10",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
